rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'username', 'karmaScore']) &&
               data.uid == userId &&
               data.username is string && data.username.size() <= 64 &&
               data.karmaScore is number;
      }
      
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                    isValidUser(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['username', 'karmaScore', 'record', 'bestStreak', 'squadId', 'photoURL']);
    }

    // --- Picks ---
    match /picks/{pickId} {
      function isValidPick(data) {
        return data.keys().hasAll(['creatorId', 'playerName', 'line', 'sport', 'type', 'lockScore', 'tails', 'fades', 'createdAt']) &&
               data.creatorId is string && data.creatorId.size() <= 128 &&
               data.playerName is string && data.playerName.size() <= 128 &&
               data.line is string && data.line.size() <= 64 &&
               data.sport in ['NBA', 'MLB'] &&
               data.type in ['public', 'private'] &&
               data.lockScore is number &&
               data.tails is number &&
               data.fades is number &&
               data.createdAt is timestamp;
      }
      
      allow get: if isSignedIn() || resource.data.type == 'public';
      allow list: if resource.data.type == 'public' || (isSignedIn() && resource.data.creatorId == request.auth.uid);
      
      allow create: if isSignedIn() && 
                    incoming().creatorId == request.auth.uid && 
                    isValidPick(incoming()) &&
                    incoming().tails == 0 &&
                    incoming().fades == 0 &&
                    incoming().createdAt == request.time;
                    
      allow update: if isSignedIn() && (
        // Action: Tail/Fade
        (incoming().diff(existing()).affectedKeys().hasOnly(['tails', 'fades']) &&
         incoming().tails >= existing().tails &&
         incoming().fades >= existing().fades) ||
         // Action: Edit (Owner only)
         (isOwner(existing().creatorId) && incoming().creatorId == existing().creatorId && isValidPick(incoming()))
      );
      
      allow delete: if isOwner(existing().creatorId);
    }

    // --- Squads ---
    match /squads/{squadId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(existing().ownerId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['memberIds']) && request.auth.uid in incoming().memberIds)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds &&
                      incoming().createdAt == request.time;
      }
    }

    // --- Daily Locks ---
    match /dailyLocks/{date} {
      allow read: if true; 
      allow write: if false;
    }

    // --- Line History ---
    match /lineHistory/{propId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Weekly Recaps ---
    match /weeklyRecaps/{recapId} {
      allow get: if isSignedIn() && (recapId.startsWith(request.auth.uid));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
