{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user data for social and betting tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "karmaScore": { "type": "number" },
        "record": {
          "type": "object",
          "properties": {
            "wins": { "type": "number" },
            "losses": { "type": "number" }
          }
        },
        "bestStreak": { "type": "number" },
        "squadId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "karmaScore"]
    },
    "Pick": {
      "title": "Betting Pick",
      "description": "A sporting prop pick shared by a user",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorKarma": { "type": "number" },
        "playerName": { "type": "string" },
        "propLine": { "type": "string" },
        "lockScore": { "type": "number" },
        "hitRate": { "type": "number" },
        "tailCount": { "type": "number" },
        "fadeCount": { "type": "number" },
        "sport": { "type": "string", "enum": ["NBA", "MLB"] },
        "status": { "type": "string", "enum": ["pending", "won", "lost"] },
        "type": { "type": "string", "enum": ["public", "private"] },
        "squadId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DailyLock": {
      "title": "AI Daily Lock",
      "description": "Daily elite pick generated by AI",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "playerName": { "type": "string" },
        "line": { "type": "string" },
        "reason": { "type": "string" },
        "lockScore": { "type": "number" },
        "sport": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Squad": {
      "title": "Betting Squad",
      "description": "A private group for friends to share picks",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "inviteCode": { "type": "string" },
        "ownerId": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and stats"
    },
    "/picks/{pickId}": {
      "schema": "Pick",
      "description": "Shared picks for community and squads"
    },
    "/squads/{squadId}": {
      "schema": "Squad",
      "description": "Private squads"
    },
    "/squads/{squadId}/messages/{messageId}": {
      "schema": {
        "type": "object",
        "properties": {
          "senderId": { "type": "string" },
          "senderName": { "type": "string" },
          "text": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      },
      "description": "Squad chat messages"
    },
    "/dailyLocks/{date}": {
      "schema": "DailyLock",
      "description": "Historical records of AI locks"
    },
    "/lineHistory/{propIdentifier}": {
      "schema": {
        "type": "object",
        "properties": {
          "playerName": { "type": "string" },
          "currentLine": { "type": "number" },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": { "type": "number" },
                "time": { "type": "string" }
              }
            }
          }
        }
      },
      "description": "Tracking prop line movements"
    },
    "/weeklyRecaps/{userId}_{week}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "hitRate": { "type": "number" },
          "coachNote": { "type": "string" },
          "grades": { "type": "object" }
        }
      },
      "description": "Personal performance recaps"
    }
  }
}
